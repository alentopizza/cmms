DATABASE_URL=postgresql://cmms:change-me@postgres:5432/cmms
APP_ADMIN_EMAIL=admin@dominio.com
APP_ADMIN_PASSWORD=change-this-before-deploy
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_NAME=Desweb CMMS
NEXT_PUBLIC_APP_URL=https://cmms.desweb.cloud

POSTGRES_DB=cmms
POSTGRES_USER=cmms
POSTGRES_PASSWORD=change-this-database-password
APP_PORT=3000
TEST_CHECKOUT_ENABLED=false
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_MS=2000


# Google Maps Platform
# Browser key: restrict by HTTP referrer and enable Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID for cloud styling / Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server-only key: restrict to Geocoding API and server/backend usage.
GOOGLE_MAPS_SERVER_API_KEY=
